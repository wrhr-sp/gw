{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "werehere-hotel-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-16",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": false,
  "r2_buckets": [
    {
      "binding": "HOTEL_FILES",
      "bucket_name": "gw-files"
    }
  ],
  "observability": {
    "enabled": true
  }
}
