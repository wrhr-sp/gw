{
  "name": "werehere-hotel-platform",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "lint": "eslint .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:boundaries": "node scripts/test-import-boundaries.mjs",
    "test:feature-guides": "pnpm --filter @werehere/ui exec vitest run test/layout-components.spec.tsx && pnpm --filter @werehere/web exec vitest run test/feature-guides.spec.ts test/account-pages.spec.tsx test/account-views.spec.tsx",
    "test:integration": "pnpm --filter @werehere/db test:integration",
    "test:mutation-verifier": "node scripts/test-file-mutation-verifier.mjs",
    "test:visual": "pnpm --filter @werehere/web test:visual",
    "test:visual:update": "pnpm --filter @werehere/web test:visual:update",
    "verify:mutations": "node scripts/verify-file-mutations.mjs",
    "check": "pnpm run typecheck && pnpm run test && pnpm run test:boundaries && pnpm run test:mutation-verifier"
  },
  "pnpm": {
    "overrides": {
      "postcss": "8.5.23",
      "sharp": "0.35.0",
      "nanoid": "3.3.18",
      "undici": "7.29.0",
      "js-yaml": "4.3.1",
      "tar": "7.5.21",
      "brace-expansion@<2": "1.1.18",
      "brace-expansion@>=2 <3": "2.1.4",
      "brace-expansion@>=4 <6": "5.0.9"
    }
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.6",
    "@eslint/js": "9.39.1",
    "@playwright/test": "1.61.1",
    "@types/node": "24.3.0",
    "eslint": "9.39.1",
    "eslint-config-next": "15.5.21",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.1",
    "vitest": "3.2.6"
  }
}
